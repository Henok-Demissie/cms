generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  sector      String
  subdomain   String       @unique
  plan        String       @default("STARTER")
  createdAt   DateTime     @default(now())
  users       User[]
  complaints  Complaint[]
  suggestions Suggestion[]
  feedback    Feedback[]
}

// ----------------------------------------------------
// CUSTOMER TABLE (Customer Accounts)
// ----------------------------------------------------
model Customer {
  id           String             @id @default(cuid())
  name         String
  firstName    String?
  lastName     String?
  email        String             @unique
  phone        String?            @unique
  gender       String?
  language     String?            @default("AM")
  nationalId   String?
  role         String             @default("CUSTOMER")
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  complaints   Complaint[]
  suggestions  Suggestion[]
  feedback     Feedback[]
  notifications Notification[]
  messages     ComplaintMessage[]
}

// ----------------------------------------------------
// STAFF / USER TABLE (Staff Accounts for Organizations)
// ----------------------------------------------------
model User {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  firstName          String?
  lastName           String?
  email              String              @unique
  phone              String?             @unique
  gender             String?
  language           String?             @default("AM")
  role               String              @default("AGENT")
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedComplaints Complaint[]         @relation("ComplaintAssignee")
  complaintMessages  ComplaintMessage[]
  complaintReactions ComplaintReaction[]

  @@index([tenantId])
}

// ----------------------------------------------------
// NOTIFICATION TABLE (Real-time updates for Customers)
// ----------------------------------------------------
model Notification {
  id         String   @id @default(cuid())
  customerId String
  type       String   // "COMPLAINT_REPLY", "STATUS_UPDATE", "SUGGESTION_RESPONSE", "FEEDBACK_RESPONSE"
  title      String
  message    String
  refType    String?  // "COMPLAINT", "SUGGESTION", "FEEDBACK"
  refId      String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ----------------------------------------------------
// COMPLAINTS
// ----------------------------------------------------
model Complaint {
  id             String              @id @default(cuid())
  tenantId       String
  customerId     String?
  assignedToId   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  source         String              @default("OTHER")
  title          String
  description    String
  status         String              @default("NEW")
  priority       String              @default("MEDIUM")
  assignedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?               @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       ComplaintMessage[]
  reactions      ComplaintReaction[]

  @@index([tenantId])
  @@index([customerId])
  @@index([assignedToId])
}

// ----------------------------------------------------
// COMPLAINT MESSAGES / THREAD
// ----------------------------------------------------
model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  authorId    String?   // Staff ID (User)
  customerId  String?   // Customer ID
  authorName  String?
  authorRole  String?   // "AGENT", "CUSTOMER", "ADMIN", etc.
  message     String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([authorId])
  @@index([customerId])
}

model ComplaintReaction {
  id          String    @id @default(cuid())
  complaintId String
  staffId     String
  type        String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([complaintId, staffId, type])
  @@index([complaintId])
}

// ----------------------------------------------------
// SUGGESTIONS
// ----------------------------------------------------
model Suggestion {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  authorId    String?
  authorName  String?
  authorEmail String?
  title       String
  description String
  status      String    @default("NEW")
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
}

// ----------------------------------------------------
// FEEDBACK
// ----------------------------------------------------
model Feedback {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  authorId    String?
  authorName  String?
  authorEmail String?
  message     String
  rating      Int?
  status      String    @default("NEW")
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
}
