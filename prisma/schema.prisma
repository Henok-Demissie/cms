generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  sector    String
  subdomain String     @unique
  plan      String     @default("STARTER")
  createdAt DateTime   @default(now())
  users     User[]
  complaints Complaint[]
  suggestions Suggestion[]
  feedback    Feedback[]
}

model User {
  id                 String      @id @default(cuid())
  tenantId           String
  name               String
  firstName          String?
  lastName           String?
  email              String      @unique
  phone              String?     @unique
  gender             String?
  language           String?     @default("AM")
  nationalId         String?
  role               String      @default("AGENT")
  passwordHash       String
  createdAt          DateTime    @default(now())
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedComplaints Complaint[] @relation("ComplaintAssignee")
  complaintMessages  ComplaintMessage[]

  @@index([tenantId])
}

model Complaint {
  id             String    @id @default(cuid())
  tenantId       String
  assignedToId   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  source         String    @default("OTHER")
  title          String
  description    String
  status         String    @default("NEW")
  priority       String    @default("MEDIUM")
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo     User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       ComplaintMessage[]
  reactions      ComplaintReaction[]

  @@index([tenantId])
  @@index([assignedToId])
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  authorId    String
  message     String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintReaction {
  id          String    @id @default(cuid())
  complaintId String
  staffId     String
  type        String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([complaintId, staffId, type])
  @@index([complaintId])
}

model Suggestion {
  id          String   @id @default(cuid())
  tenantId    String
  authorId    String
  title       String
  description String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  authorId  String
  message   String
  rating    Int?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
