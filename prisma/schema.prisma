generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  sector    String
  subdomain String     @unique
  plan      String     @default("STARTER")
  createdAt DateTime   @default(now())
  users     User[]
  complaints Complaint[]
}

model User {
  id                 String      @id @default(cuid())
  tenantId           String
  name               String
  firstName          String?
  lastName           String?
  email              String      @unique
  phone              String?     @unique
  gender             String?
  language           String?     @default("AM")
  nationalId         String?
  role               String      @default("AGENT")
  passwordHash       String
  createdAt          DateTime    @default(now())
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedComplaints Complaint[] @relation("ComplaintAssignee")

  @@index([tenantId])
}

model Complaint {
  id             String    @id @default(cuid())
  tenantId       String
  assignedToId   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  source         String    @default("OTHER")
  title          String
  description    String
  status         String    @default("NEW")
  priority       String    @default("MEDIUM")
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo     User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([assignedToId])
}
